WANDERMIND_ENV=dev
WANDERMIND_LOG_LEVEL=INFO
WANDERMIND_DATABASE_URL=postgresql+asyncpg://wandermind:wandermind@localhost:5432/wandermind
WANDERMIND_CORS_ORIGINS=["http://localhost:5173"]
WANDERMIND_ACCESS_USERNAME=wandermind
WANDERMIND_ACCESS_PASSWORD=
WANDERMIND_STATIC_DIR=
WANDERMIND_EMBEDDING_DIMENSIONS=96
WANDERMIND_RUNTIME_ADAPTER=mock
WANDERMIND_CODEX_EXECUTABLE=codex
WANDERMIND_RUNTIME_CWD=
WANDERMIND_RUNTIME_TIMEOUT_SECONDS=60
WANDERMIND_RUNTIME_MAX_RETRIES=2
WANDERMIND_WONDER_THRESHOLD=0.58
WANDERMIND_CHEAP_SCORE_THRESHOLD=0.40
WANDERMIND_SCORE_WEIGHTS={"novelty":0.18,"surprise":0.12,"personal_relevance":0.18,"coherence":0.12,"generativity":0.14,"explanatory_power":0.10,"evidence_potential":0.08,"cross_domain_value":0.08,"redundancy_penalty":0.12,"arbitrariness_penalty":0.10,"hallucination_risk_penalty":0.15}
WANDERMIND_ENABLE_SCHEDULER=false
WANDERMIND_INCUBATION_INTERVAL_MINUTES=360
WANDERMIND_MAX_REQUEST_BYTES=2100000
WANDERMIND_AUTO_CREATE_SCHEMA=true
